<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".PartCycleCount_Auto_Activity">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="3"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface"
            android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mold Cycle Count"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:layout_weight="3"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Bold" />

        <ImageView
            android:id="@+id/refreshBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_refresh"
            app:tint="@color/on_surface"
            android:contentDescription="Refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@+id/buttonLayout"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rfidButtonCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_marginHorizontal="10dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="10dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/rfid_signal"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Rfid signal"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Note: Tap START to begin scanning RFID tags and part cycle count, and STOP to pause part cyle count."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/rfidButtonLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rfidStartBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="10dp"
                        android:layout_marginEnd="5dp"
                        android:backgroundTint="@color/holo_green"
                        android:letterSpacing="0.01"
                        android:text="Start"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:elevation="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rfidStopBtn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="10dp"
                        android:layout_marginStart="5dp"
                        android:backgroundTint="@color/gray_600"
                        android:letterSpacing="0.01"
                        android:text="Stop"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:elevation="4dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/validTagTableCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="10dp"
            app:cardBackgroundColor="@color/card_background"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Valid Tags Details"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_secondary"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/on_surface_variant"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/validTagNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/on_surface_variant"
                    android:text="Note: All the valid RFID tags will be displayed in the below table."/>

                <TextView
                    android:id="@+id/validTagCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valid Tags Count: 0"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <TableLayout
                            android:id="@+id/validTagsTableLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*"
                            android:showDividers="middle"
                            android:divider="@drawable/table_divider"
                            android:dividerHeight="1dp">

                            <TableRow
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/color_primary_dark">

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Sr. No."
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="RFID Tag Value"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Previous Cycle Count"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Current Cycle Count"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Max Cycle Count"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Part Name"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Part Unique No."
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Part Code"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Status"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                            </TableRow>

                        </TableLayout>

                    </HorizontalScrollView>

                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/validTagsPaginationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/pagination_background"
            android:padding="8dp">

            <!-- Previous Button -->
            <ImageView
                android:id="@+id/validTagsPreviousIcon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_previous"
                android:contentDescription="Previous"
                android:background="@drawable/selected_page_background"
                app:tint="@color/on_surface"
                android:clickable="true"
                android:focusable="true" />

            <!-- Page Numbers -->
            <TextView
                android:id="@+id/validTagsPageNumbers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <!-- Next Button -->
            <ImageView
                android:id="@+id/validTagsNextIcon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_next"
                android:contentDescription="Next"
                android:background="@drawable/selected_page_background"
                app:tint="@color/on_surface"
                android:clickable="true"
                android:focusable="true" />

            <!-- Dropdown for Rows per Page -->
            <Spinner
                android:id="@+id/validTagsRowsPerPageSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="8dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/error"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invalid Scan"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/white" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/invalidTagTableCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/card_background"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Invalid Tags Details"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_secondary"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/on_surface_variant"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/invalidTagNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="@color/on_surface_variant"
                    android:text="Note: All the invalid RFID tags will be displayed in the below table."/>

                <TextView
                    android:id="@+id/invalidTagCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invalid Tags Count: 0"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textStyle="bold"
                    android:textAlignment="center" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="8dp">

                        <TableLayout
                            android:id="@+id/invalidTagsTableLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:stretchColumns="*"
                            android:showDividers="middle"
                            android:divider="@drawable/table_divider"
                            android:dividerHeight="1dp">

                            <TableRow
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/color_primary_dark">

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Sr. No."
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="RFID Tag Value"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                                <TextView
                                    android:textAlignment="center"
                                    android:background="@drawable/table_cell_border"
                                    android:padding="8dp"
                                    android:text="Status"
                                    android:textColor="@color/white"
                                    android:textStyle="bold" />

                            </TableRow>

                        </TableLayout>

                    </HorizontalScrollView>

                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/invalidTagsPaginationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/pagination_background"
            android:padding="8dp">

            <!-- Previous Button -->
            <ImageView
                android:id="@+id/invalidTagsPreviousIcon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_previous"
                android:contentDescription="Previous"
                android:background="@drawable/selected_page_background"
                app:tint="@color/on_surface"
                android:clickable="true"
                android:focusable="true" />

            <!-- Page Numbers -->
            <TextView
                android:id="@+id/invalidTagsPageNumbers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <!-- Next Button -->
            <ImageView
                android:id="@+id/invalidTagsNextIcon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ic_next"
                android:contentDescription="Next"
                android:background="@drawable/selected_page_background"
                app:tint="@color/on_surface"
                android:clickable="true"
                android:focusable="true" />

            <!-- Dropdown for Rows per Page -->
            <Spinner
                android:id="@+id/invalidTagsRowsPerPageSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:padding="8dp" />
        </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:backgroundTint="@color/color_primary"
            android:letterSpacing="0.01"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:elevation="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>